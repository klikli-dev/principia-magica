{
  "multipart": [
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_off"
      },
      "when": {
        "facing": "north",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_on"
      },
      "when": {
        "facing": "north",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_off",
        "y": 90
      },
      "when": {
        "facing": "east",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_on",
        "y": 90
      },
      "when": {
        "facing": "east",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_off",
        "y": 180
      },
      "when": {
        "facing": "south",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_on",
        "y": 180
      },
      "when": {
        "facing": "south",
        "open": "true"
      }
    },
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_off",
        "y": 270
      },
      "when": {
        "facing": "west",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "principiamagica:block/libation_spout_on",
        "y": 270
      },
      "when": {
        "facing": "west",
        "open": "true"
      }
    }
  ]
}